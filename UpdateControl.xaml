<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Update Control" Width="1160" Height="810" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0B1120" Foreground="#EDF3FA" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9AAEC5"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Button" TargetType="Button">
      <Setter Property="Background" Value="#23334B"/><Setter Property="Foreground" Value="#EDF3FA"/>
      <Setter Property="BorderBrush" Value="#3C5069"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141F31"/><Setter Property="BorderBrush" Value="#2B3B51"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="21"/></Style>
    <Style x:Key="ModeChoice" TargetType="RadioButton">
      <Setter Property="Background" Value="#141F31"/><Setter Property="BorderBrush" Value="#34465F"/>
      <Setter Property="Foreground" Value="#EDF3FA"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="12" Padding="18">
          <Grid>
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Border x:Name="ChoiceRing" Width="20" Height="20" CornerRadius="10" BorderBrush="#7F99B8" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top"><Ellipse x:Name="ChoiceDot" Width="10" Height="10" Fill="#4CE1BE" Visibility="Collapsed"/></Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#1C2B42"/><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#92B8DD"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#123331"/><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#4CE1BE"/><Setter TargetName="ChoiceRing" Property="BorderBrush" Value="#4CE1BE"/><Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Width" Value="42"/><Setter Property="Padding" Value="0"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#3D506B" CornerRadius="4" Margin="1,2"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="#101A2B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#141F31"/><Setter Property="Foreground" Value="#DBE6F4"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="#141F31"/><Setter Property="AlternatingRowBackground" Value="#19263A"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="RowHeight" Value="38"/><Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2A3F"/><Setter Property="Foreground" Value="#9DB4D0"/><Setter Property="Padding" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style></Setter.Value></Setter>
      <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="RenderRoot" BorderBrush="#2B394E" BorderThickness="1" Background="#0B1120">
    <Grid>
      <Grid x:Name="AppContent">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#101827" BorderBrush="#253349" BorderThickness="0,0,0,1">
        <Grid Margin="18,0,5,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="TitleIcon" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="Update Control" Foreground="#C5D4E5" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text=" /  Desktop edition" Foreground="#748BA6" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#x2014;" ToolTip="Minimize"/><Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#x25A1;" ToolTip="Maximize or restore"/><Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#x2715;" ToolTip="Close"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#101827" BorderBrush="#253349" BorderThickness="0,0,1,0" Padding="16,28,16,20">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
              <Image x:Name="BrandIcon" Width="52" Height="52" HorizontalAlignment="Left" Margin="9,0,0,12"/>
              <TextBlock Text="UPDATE" FontSize="21" FontWeight="Bold" Margin="12,0,0,0"/><TextBlock Text="CONTROL" FontSize="21" FontWeight="Light" Foreground="#90A8C4" Margin="12,0,0,30"/>
              <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Content="Overview"/>
              <Button x:Name="DetailsNav" Style="{StaticResource NavButton}" Content="System details"/>
              <Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Content="Activity &amp; logs"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <Border Height="1" Background="#293A51" Margin="12,0,12,16"/>
              <TextBlock x:Name="AccessText" Text="Checking access" Foreground="#4CE1BE" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,6"/>
              <TextBlock Text="v4.2.2  /  Local control" Foreground="#788FA9" FontSize="11" Margin="12,0,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="MainScroll" Padding="28,25,28,20">
            <StackPanel>
              <Grid Margin="0,0,0,21"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="PageTitle" Text="Your updates. Your call." FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Choose the right balance for this PC." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh status" Style="{StaticResource Button}" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Read the current services, policies and scheduled tasks"/>
              </Grid>
              <Border x:Name="StatusCard" Style="{StaticResource Card}" Margin="0,0,0,22" Padding="22,18" BorderBrush="#35506A">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="CURRENT MODE" Foreground="#8BA5C4" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,4"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8BA5C4" Margin="0,0,10,0"/><TextBlock x:Name="ModeText" Text="Checking this PC..." FontSize="24" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ModeDescription" Text="Reading update services and watchdogs." Foreground="#A9BBD1" MaxWidth="550" HorizontalAlignment="Left"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" MinWidth="100"><TextBlock Text="WATCHDOGS" Foreground="#8BA5C4" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="WatchdogCount" Text="--" FontSize="32" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock x:Name="CheckedText" Text="Not checked yet" Foreground="#7E96B2" FontSize="11" HorizontalAlignment="Right"/></StackPanel>
                </Grid>
              </Border>
              <Border x:Name="NoticePanel" CornerRadius="8" Background="#33291A" BorderBrush="#8D6931" BorderThickness="1" Padding="15,12" Margin="0,0,0,18" Visibility="Collapsed"><TextBlock x:Name="NoticeText" Foreground="#F3D89F"/></Border>
              <StackPanel x:Name="OverviewPage">
                <TextBlock Text="1  Select a mode" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="Click anywhere on a card. Selecting a mode does not change Windows." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,16" KeyboardNavigation.DirectionalNavigation="Contained"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <RadioButton x:Name="StoreChoice" Tag="Store" GroupName="UpdateMode" Grid.Column="0" Style="{StaticResource ModeChoice}" AutomationProperties.Name="Store Friendly" AutomationProperties.HelpText="Select this mode. Use Apply Store Friendly to change Windows." ToolTip="Select Store Friendly; Windows stays unchanged until you apply.">
                    <StackPanel>
                      <TextBlock Text="RECOMMENDED" Foreground="#62E5C6" FontSize="10" FontWeight="Bold" Margin="0,0,30,0"/>
                      <TextBlock Text="Store Friendly" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,10"/>
                      <TextBlock Text="Keep automatic Windows updates manual while installing Store apps." Foreground="{StaticResource Muted}" MinHeight="55" LineHeight="19"/>
                      <StackPanel Margin="0,14,0,0"><TextBlock Text="OS updates       Manual" Foreground="#C6D8E8" FontSize="12" Margin="0,0,0,7"/><TextBlock Text="App downloads   Available" Foreground="#C6D8E8" FontSize="12" Margin="0,0,0,7"/><TextBlock Text="Watchdogs        None" Foreground="#C6D8E8" FontSize="12"/></StackPanel>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="HardChoice" Tag="Hard" GroupName="UpdateMode" Grid.Column="2" Style="{StaticResource ModeChoice}" AutomationProperties.Name="Hard Block" AutomationProperties.HelpText="Select this mode. Review and confirm Hard Block separately." ToolTip="Select Hard Block to review it. Nothing changes until you apply and confirm.">
                    <StackPanel>
                      <TextBlock Text="STRICT CONTROL" Foreground="#D6AAB7" FontSize="10" FontWeight="Bold" Margin="0,0,30,0"/>
                      <TextBlock Text="Hard Block" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,10"/>
                      <TextBlock Text="Stop shared update services. Store downloads can stop too." Foreground="{StaticResource Muted}" MinHeight="55" LineHeight="19"/>
                      <StackPanel Margin="0,14,0,0"><TextBlock Text="OS services      Disabled" Foreground="#C6D8E8" FontSize="12" Margin="0,0,0,7"/><TextBlock Text="App downloads   Restricted" Foreground="#E0B6C0" FontSize="12" Margin="0,0,0,7"/><TextBlock Text="Watchdogs        One" Foreground="#C6D8E8" FontSize="12"/></StackPanel>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="RestoreChoice" Tag="Restore" GroupName="UpdateMode" Grid.Column="4" Style="{StaticResource ModeChoice}" AutomationProperties.Name="Restore Windows" AutomationProperties.HelpText="Select restoration. Use Restore Windows to remove this tool's settings." ToolTip="Select Restore; your current settings stay in place until you apply.">
                    <StackPanel>
                      <TextBlock Text="BACK TO NORMAL" Foreground="#9EBFF0" FontSize="10" FontWeight="Bold" Margin="0,0,30,0"/>
                      <TextBlock Text="Restore" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,10"/>
                      <TextBlock Text="Remove this tool's block and restore your saved Windows settings." Foreground="{StaticResource Muted}" MinHeight="55" LineHeight="19"/>
                      <StackPanel Margin="0,14,0,0"><TextBlock Text="OS settings      Restored" Foreground="#C6D8E8" FontSize="12" Margin="0,0,0,7"/><TextBlock Text="App downloads   Re-enabled*" Foreground="#C6D8E8" FontSize="12" Margin="0,0,0,7"/><TextBlock Text="Watchdogs        Removed" Foreground="#C6D8E8" FontSize="12"/></StackPanel>
                    </StackPanel>
                  </RadioButton>
                </Grid>
                <TextBlock Text="Store Friendly: Pro, Enterprise, Education and IoT Enterprise. Pending updates are not cancelled. *Other software or organization policies may still restrict downloads." Foreground="{StaticResource Muted}" FontSize="11" LineHeight="17" Margin="1,0,1,0"/>
              </StackPanel>
              <StackPanel x:Name="DetailsPage" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Update &amp; app services" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="A stopped Manual service can start when Windows needs it. Disabled means it cannot start." Foreground="{StaticResource Muted}" Margin="0,0,0,18" FontSize="12"/><DataGrid x:Name="ServicesGrid"><DataGrid.Columns><DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="*" MinWidth="230"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="140"/><DataGridTextColumn Header="Startup" Binding="{Binding Startup}" Width="140"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Watchdog tasks" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="TasksText" Text="No status yet." Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/><TextBlock x:Name="PolicyText" Text="" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel></Border>
              </StackPanel>
              <StackPanel x:Name="ActivityPage" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="This session" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBox x:Name="ActivityText" Background="#0D1625" Foreground="#B9CDE4" BorderBrush="#2B3B51" BorderThickness="1" Padding="14" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="230" MaxHeight="420"/><WrapPanel Margin="0,18,0,0"><Button x:Name="LogsButton" Content="Open logs &amp; backups" Style="{StaticResource Button}" Margin="0,0,10,8"/><Button x:Name="ReportButton" Content="Save diagnostic report" Style="{StaticResource Button}" Margin="0,0,10,8"/><Button x:Name="CopyButton" Content="Copy activity" Style="{StaticResource Button}" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="SavedPathText" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
              </StackPanel>
              <Border x:Name="ResultPanel" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ResultTitle" Text="" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ResultMessage" Text="" Foreground="#B4C7DD" Margin="0,7,0,0" LineHeight="20"/></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
                <Border x:Name="SelectionPanel" Grid.Row="1" Background="#152235" BorderBrush="#354C68" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="28,0,28,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="SelectionTitle" Text="2  Apply your selection" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SelectionHint" Text="Select a card above to continue." Foreground="#AEC2DA" FontSize="12" Margin="0,6,14,0" LineHeight="18"/></StackPanel>
                    <Button x:Name="ApplyButton" Grid.Column="1" Content="Select a mode" Style="{StaticResource Button}" Background="#4CE1BE" Foreground="#08251F" BorderBrush="#4CE1BE" MinWidth="206" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"/>
                  </Grid>
                </Border>
          <Border Grid.Row="2" Background="#101A2B" BorderBrush="#293A50" BorderThickness="0,1,0,0" Padding="27,14">
            <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OperationText" Text="Connecting to the local controller..." Foreground="#BED0E6" FontSize="12"/><TextBlock x:Name="SystemText" Grid.Column="1" Foreground="#7F98B5" FontSize="11" Margin="15,0,0,0"/></Grid><ProgressBar x:Name="ProgressBar" Height="3" Margin="0,10,0,0" Background="#263750" Foreground="#4CE1BE" BorderThickness="0" IsIndeterminate="True"/></StackPanel>
          </Border>
        </Grid>
      </Grid>
      </Grid>
      <Border x:Name="ConfirmOverlay" KeyboardNavigation.TabNavigation="Cycle" Background="#CC060B14" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BorderBrush="#8B5C6D"><StackPanel><TextBlock Text="Apply Hard Block?" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="This stops Windows update services and prevents Microsoft Store downloads, including ChatGPT. Automatic OS security updates also stop." Margin="0,16,0,0" Foreground="#C3CDDC" LineHeight="22"/><TextBlock Text="You can switch back with Store Friendly or Restore." Margin="0,12,0,24" Foreground="#9BB2CA"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="CancelHardButton" Content="Keep current mode" Style="{StaticResource Button}" Padding="10,12"/><Button x:Name="ConfirmHardButton" Grid.Column="2" Content="Apply Hard Block" Style="{StaticResource Button}" Background="#944B63" BorderBrush="#BC708A" Padding="10,12"/></Grid></StackPanel></Border>
      </Border>
    </Grid>
  </Border>
</Window>
